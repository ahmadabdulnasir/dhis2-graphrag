# DHIS2 instance (public demo shown; replace with NHMIS instance when access is granted)
DHIS2_BASE_URL=https://play.dhis2.org/dev
DHIS2_USERNAME=admin
DHIS2_PASSWORD=district
# Or a personal access token instead of username/password
DHIS2_PAT=

# Neo4j (docker compose up -d starts a local instance matching these defaults)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=graphrag-dev

# LLM generation (optional — offline template answerer is used when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
